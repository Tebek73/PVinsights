# MkDocs static site output
docs/site/

# Optional documentation (keep local, don't upload)
docs/
**/*.md
**/*.pdf

# Generated TypeDoc HTML (optional)
docs/manual/typedoc-server/

# PDF build intermediates
docs/pdf/_merged-*.md

# Cursor / IDE
.cursor/
**/.cursor/
**/agent-transcripts/

# Dependencies / builds
**/node_modules/
server/dist/
client/dist/

# Static docs output we DO commit:
# docs/html/codebase/
# docs/html/business/

# Angular specific
/dist/
/out-tsc/
/tmp/
/coverage/
/e2e/test-output/
/.angular/
.angular/

# Node modules and dependency files
/node_modules/
/package-lock.json
/yarn.lock

# Environment files
/.env

# Angular CLI and build artefacts
/.angular-cli.json
/.ng/

# TypeScript cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
